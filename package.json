{
  "name": "screen-self-service",
  "private": true,
  "version": "1.0.0",
  "description": "Screen Self-Service for Jira — a SUPERPORT Forge app",
  "scripts": {
    "build:ui": "npm --prefix static/app run build",
    "typecheck": "tsc --noEmit && npm --prefix static/app run typecheck",
    "deploy": "npm run build:ui && forge deploy -e development --non-interactive",
    "test": "vitest run"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/kvs": "^2.1.1",
    "@forge/resolver": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
